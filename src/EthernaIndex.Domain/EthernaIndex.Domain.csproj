<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Etherna.EthernaIndex.Domain</RootNamespace>

    <Authors>Etherna SA</Authors>
    
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Nullable>enable</Nullable>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisMode>AllEnabledByDefault</AnalysisMode>
    <Configurations>Debug;Release</Configurations>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Etherna.DomainEvents" Version="1.4.0" />
    <PackageReference Include="EthernaSdk.Tools.Video" Version="0.4.0-alpha.165" />
    <PackageReference Include="MongODM.Core" Version="0.25.0-alpha.4" />
    <PackageReference Include="Nethereum.Util" Version="4.26.0" />
  </ItemGroup>

</Project>
